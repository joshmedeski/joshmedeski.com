---
import { getCollection } from 'astro:content'
import Layout from '../../components/Layout.astro'
import PageTitle from '../../components/PageTitle.astro'
import Wrapper from '../../components/Wrapper.astro'
import AreaIcon from '~/components/AreaIcon.astro'
import {
  topLevelAreas,
  subAreasOf,
  areaHref,
  validateTwoLevel,
} from '~/utils/areas'

const areas = await getCollection('areas')
validateTwoLevel(areas)
const tops = topLevelAreas(areas)
---

<Layout title="Areas" description="Browse everything by topic area.">
  <Wrapper>
    <PageTitle>Areas</PageTitle>
    <div class="mb-32 flex flex-row flex-wrap items-start gap-8">
      {
        tops.map((area) => {
          const subs = subAreasOf(area, areas)
          return (
            <section>
              <a
                href={areaHref(area)}
                class={`inline-flex items-center gap-3 rounded-full px-5 py-2 text-2xl font-bold transition-opacity hover:opacity-80 ${area.data.themeColor ?? 'bg-neutral-900'}`}
              >
                <AreaIcon icon={area.data.icon} />
                {area.data.title}
              </a>
              {subs.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2 pl-5">
                  {subs.map((sub) => (
                    <li>
                      <a
                        href={areaHref(sub)}
                        class={`inline-flex items-center gap-2 rounded-full px-4 py-1 text-base transition-opacity hover:opacity-80 ${area.data.themeColor ?? 'bg-neutral-900'}`}
                      >
                        <AreaIcon icon={sub.data.icon} />
                        {sub.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        })
      }
    </div>
  </Wrapper>
</Layout>
