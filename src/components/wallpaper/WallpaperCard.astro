---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { IMAGE_WIDTH } from '~/utils/images'
import { serviceId, wallpaperSize } from '~/utils/wallpapers'
import WallpaperBadge from './WallpaperBadge.astro'

interface Props {
  wallpaper: CollectionEntry<'wallpapers'>
  eager?: boolean
  style?: string
}

const { wallpaper, eager, style } = Astro.props

const { width, favorite } = wallpaper.data
const size = wallpaperSize(width)
---

<a
  href={`/wallpapers/${wallpaper.id}`}
  class="flex flex-col"
  data-astro-prefetch
  data-size={size}
  data-favorite={favorite ? 'true' : 'false'}
  data-service={serviceId(wallpaper.data.service)}
  style={style}
>
  <div class="relative">
    <Image
      src={wallpaper.data.image}
      alt={wallpaper.data.title}
      width={IMAGE_WIDTH.card}
      loading={eager ? 'eager' : 'lazy'}
      class="w-full rounded-lg bg-black shadow-md mb-4"
      transition:name={`wallpaper-${wallpaper.id}-thumb`}
    />
    <div class="absolute top-2 right-2 flex gap-1">
      {
        favorite && (
          <span title="Show all favorites" class="cursor-pointer">
            <WallpaperBadge favorite>Favorite</WallpaperBadge>
          </span>
        )
      }
      <WallpaperBadge>{size}</WallpaperBadge>
    </div>
  </div>
  <div class="">
    <h3
      class="text-2xl font-bold leading-none"
      transition:name={`wallpaper-${wallpaper.id}-title`}
    >
      {wallpaper.data.title}
    </h3>
  </div>
</a>

<script>
  import { navigate } from 'astro:transitions/client'

  document.addEventListener(
    'click',
    (event) => {
      const badge =
        event.target instanceof Element &&
        event.target.closest('a[data-size] [data-favorite-badge]')
      if (!badge) return
      event.preventDefault()
      event.stopPropagation()
      navigate('/wallpapers/?favorites')
    },
    true,
  )
</script>
