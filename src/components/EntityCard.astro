---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { resolveThemeArea } from '~/utils/areas'

interface Props {
  href: string
  title: string
  description: string
  image: ImageMetadata
  /** Area references for the entity; the first one drives the card theme. */
  areas?: { collection: 'areas'; id: string }[]
  /** Prefix for the `transition:name` pair, e.g. `post-my-slug`. */
  transitionPrefix: string
  /** Renders a hidden full-size image so the detail page loads instantly. */
  preloadWidth?: string
  preloadHeight?: string
}

const {
  href,
  title,
  description,
  image,
  areas: areaRefs,
  transitionPrefix,
  preloadWidth,
  preloadHeight,
} = Astro.props

const hasMeta = Astro.slots.has('meta')
const isExternal = href.startsWith('http')
const areas = await getCollection('areas')
const themeColor =
  resolveThemeArea({ data: { areas: areaRefs } }, areas)?.data.themeColor ??
  'bg-neutral-900'
// Tailwind can't generate a `border-*` class built at runtime, so the border
// color comes from the theme variable backing the area's `bg-*` utility.
const borderColor = `var(${themeColor.replace('bg-', '--color-')})`
---

<div
  class=`relative flex flex-col justify-end rounded-lg border-2 px-4 py-4 shadow-md md:px-6 ${themeColor}`
  style={`border-color: ${borderColor}`}
>
  <a
    href={href}
    class="z-20 grid grow gap-4 md:grid-cols-5 md:gap-6"
    data-astro-prefetch={!isExternal}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
  >
    <div
      class="flex flex-col justify-end md:col-span-2 md:col-start-4 md:row-start-1"
    >
      <div class="relative">
        <slot name="badge" />
        <Image
          src={image}
          alt={title}
          width="500"
          height="281.25"
          class="mb-2 aspect-video w-full rounded-lg bg-black object-cover shadow-md md:mb-8"
          transition:name={`${transitionPrefix}-thumb`}
          style={{ backgroundColor: '#000' }}
        />
      </div>
      {
        preloadWidth && preloadHeight && (
          <Image
            src={image}
            alt={title}
            width={preloadWidth}
            height={preloadHeight}
            class="hidden"
          />
        )
      }
    </div>

    <div
      class="md:col-start-0 flex flex-col justify-end md:col-span-3 md:row-start-1"
    >
      <div class="flex grow flex-col justify-center">
        <h3
          class="mb-2 mr-4 text-balance text-xl font-extrabold leading-tight"
          transition:name={`${transitionPrefix}-title`}
        >
          {title}
        </h3>
      </div>

      <p
        class:list={[
          '-ml-3 rounded-t-md bg-neutral-900 p-3 text-sm text-slate-500',
          hasMeta ? 'mb-12' : 'mb-0 rounded-b-md',
        ]}
      >
        {description}
      </p>
    </div>
  </a>

  {
    hasMeta && (
      <div class="z-10 -mx-4 -mb-4 -mt-20 rounded-b-md bg-neutral-900 px-4 pb-2 pt-14 md:-mx-6 md:px-6">
        <slot name="meta" />
      </div>
    )
  }
</div>
