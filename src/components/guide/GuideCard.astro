---
import type { CollectionEntry } from 'astro:content'
import FeatureCard from '../FeatureCard.astro'
import GuideMeta from './GuideMeta.astro'

interface Props {
  guide: CollectionEntry<'guides'>
  eager?: boolean
  class?: string
}

const { guide, eager, class: className } = Astro.props
---

<FeatureCard
  href={`/guides/${guide.id}`}
  image={guide.data.heroImage}
  title={guide.data.title}
  description={guide.data.description}
  eager={eager}
  class={className}
>
  <GuideMeta slot="meta" guide={guide} align="left" />
</FeatureCard>
