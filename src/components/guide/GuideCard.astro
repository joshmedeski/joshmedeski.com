---
import type { CollectionEntry } from 'astro:content'
import EntityCard from '../EntityCard.astro'
import GuideMeta from './GuideMeta.astro'

interface Props {
  guide: CollectionEntry<'guides'>
}

const { guide } = Astro.props
---

<EntityCard
  href={`/guides/${guide.id}`}
  title={guide.data.title}
  description={guide.data.description}
  image={guide.data.heroImage}
  areas={guide.data.areas}
  transitionPrefix={`guide-${guide.id}`}
  preloadWidth="1640"
  preloadHeight="922.5"
>
  <GuideMeta slot="meta" guide={guide} align="left" />
</EntityCard>
