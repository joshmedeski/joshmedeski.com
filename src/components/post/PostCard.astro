---
import type { CollectionEntry } from 'astro:content'
import FeatureCard from '../FeatureCard.astro'
import PostMeta from './PostMeta.astro'

interface Props {
  post: CollectionEntry<'posts'>
  eager?: boolean
  eyebrow?: string
  class?: string
  size?: 'sm' | 'lg'
  sizes?: string
}
const {
  post,
  eager,
  eyebrow,
  class: className,
  size = 'sm',
  sizes,
} = Astro.props
---

<FeatureCard
  href={`/posts/${post.id}`}
  image={post.data.heroImage}
  title={post.data.title}
  description={post.data.description}
  eyebrow={eyebrow}
  eager={eager}
  class={className}
  transitionPrefix={`post-${post.id}`}
  size={size}
  sizes={sizes}
>
  <PostMeta slot="meta" post={post} align="left" />
</FeatureCard>
