---
import type { CollectionEntry } from 'astro:content'
import FeatureCard from '../FeatureCard.astro'
import PostMeta from './PostMeta.astro'

interface Props {
  post: CollectionEntry<'posts'>
  eager?: boolean
  eyebrow?: string
  class?: string
  size?: 'sm' | 'lg'
  sizes?: string
}
const {
  post,
  eager,
  eyebrow,
  class: className,
  size = 'sm',
  sizes,
} = Astro.props
---

<FeatureCard
  href={`/posts/${post.id}`}
  image={post.data.heroImage}
  title={post.data.title}
  description={post.data.description}
  eyebrow={eyebrow}
  eager={eager}
  class={className}
  transitionPrefix={`post-${post.id}`}
  size={size}
  sizes={sizes}
>
  {
    post.data.draft && (
      <span
        slot="badge"
        class="absolute right-2 top-2 z-30 rounded bg-amber-400 px-2 py-0.5 text-xs font-extrabold uppercase tracking-wider text-black shadow-md"
      >
        Draft
      </span>
    )
  }
  <PostMeta slot="meta" post={post} align="left" />
</FeatureCard>
