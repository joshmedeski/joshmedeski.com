---
import type { CollectionEntry } from 'astro:content'
import EntityCard from '../EntityCard.astro'
import PostMeta from './PostMeta.astro'

interface Props {
  post: CollectionEntry<'posts'>
}
const { post } = Astro.props
---

<EntityCard
  href={`/posts/${post.id}`}
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  areas={post.data.areas}
  transitionPrefix={`post-${post.id}`}
  preloadWidth="1640"
  preloadHeight="922.5"
>
  {
    post.data.draft && (
      <span
        slot="badge"
        class="absolute right-2 top-2 z-30 rounded bg-amber-400 px-2 py-0.5 text-xs font-extrabold uppercase tracking-wider text-black shadow-md"
      >
        Draft
      </span>
    )
  }
  <PostMeta slot="meta" post={post} align="left" />
</EntityCard>
