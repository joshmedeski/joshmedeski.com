---
import { CollectionEntry, getEntry } from 'astro:content'
import AreaBadges from '../AreaBadges.astro'
import { GuideIcon } from '../icons/index.astro'
import { pillClass, type PillSize } from '~/utils/pills'

interface Props {
  post: CollectionEntry<'posts'>
  align?: 'left' | 'center'
  size?: PillSize
}

const {
  align = 'center',
  size = 'sm',
  post: {
    data: { pubDate, duration, guide: postGuide, areas },
  },
} = Astro.props

const pill = pillClass(size)

let guide: CollectionEntry<'guides'> | undefined
if (postGuide) guide = await getEntry(postGuide.ref)
---

<div
  class:list={[
    'flex w-full flex-wrap items-center gap-2 font-medium',
    align === 'left' ? 'justify-start' : 'justify-center',
  ]}
>
  <AreaBadges areas={areas} pillClass={pill} />

  {
    guide && (
      <a href={`/guides/${guide.id}`} class={`${pill} hover:bg-neutral-700`}>
        <GuideIcon class={size === 'lg' ? 'w-5' : 'w-4'} />
        <span>{guide.data.title}</span>
      </a>
    )
  }

  <div class={pill}>
    <span aria-hidden="true">📅</span>
    <span>
      <time>
        {
          new Date(pubDate).toLocaleDateString('en-US', {
            month: 'short',
            day: '2-digit',
            year: 'numeric',
          })
        }
      </time>
    </span>
  </div>

  {
    duration && (
      <div class={pill}>
        <span aria-hidden="true">🎬</span>
        <span>{duration}</span>
      </div>
    )
  }
</div>
