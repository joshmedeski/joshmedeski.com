---
import { getEntry } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import AreaBadges from '../AreaBadges.astro'
import { GuideIcon } from '../icons/index.astro'
import { pillClass, type PillSize } from '~/utils/pills'
import { readingMinutes } from '~/utils/posts'

interface Props {
  post: CollectionEntry<'posts'>
  align?: 'left' | 'center'
  size?: PillSize
  updated?: boolean
}

const {
  align = 'center',
  size = 'sm',
  updated = false,
  post: {
    body,
    data: {
      pubDate,
      updatedDate,
      duration,
      videoType,
      guide: postGuide,
      areas,
    },
  },
} = Astro.props

const pill = pillClass(size)

let guide: CollectionEntry<'guides'> | undefined
if (postGuide) guide = await getEntry(postGuide.ref)
---

<div
  class:list={[
    'flex w-full flex-wrap items-center gap-2 font-medium',
    align === 'left' ? 'justify-start' : 'justify-center',
  ]}
>
  <AreaBadges areas={areas} pillClass={pill} />

  {
    guide && (
      <a href={`/guides/${guide.id}`} class={`${pill} hover:bg-neutral-700`}>
        <GuideIcon class={size === 'lg' ? 'w-5' : 'w-4'} />
        <span>{guide.data.title}</span>
      </a>
    )
  }

  <div class={pill}>
    <span aria-hidden="true">📅</span>
    <span>
      <time>
        {
          new Date(pubDate).toLocaleDateString('en-US', {
            month: 'short',
            day: '2-digit',
            year: 'numeric',
          })
        }
      </time>
    </span>
  </div>

  {
    updated && updatedDate && (
      <div class={pill}>
        <span aria-hidden="true">🔄</span>
        <span>
          Updated{' '}
          <time datetime={updatedDate}>
            {new Date(updatedDate).toLocaleDateString('en-US', {
              month: 'short',
              day: '2-digit',
              year: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
        </span>
      </div>
    )
  }

  {
    duration ? (
      <div class={pill}>
        <span aria-hidden="true">
          {videoType === 'livestream' ? '🔴' : '🎬'}
        </span>
        <span>
          {videoType === 'livestream' && 'Live · '}
          {duration}
        </span>
      </div>
    ) : (
      <div class={pill}>
        <span aria-hidden="true">📖</span>
        <span>{readingMinutes(body)} min read</span>
      </div>
    )
  }
</div>
