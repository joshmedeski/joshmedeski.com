---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

interface Props {
  use: CollectionEntry<'uses'>
  eager?: boolean
}

const { use, eager } = Astro.props
---

<a href={`/uses/${use.id}`} class="group flex flex-col" data-astro-prefetch>
  <Image
    src={use.data.image}
    alt={use.data.title}
    width="558"
    height="372"
    loading={eager ? 'eager' : 'lazy'}
    class="mb-4 aspect-[3/2] w-full rounded-lg bg-black object-cover shadow-md transition group-hover:scale-[1.02]"
    transition:name={`use-${use.data.title}-thumb`}
  />
  <h3 class="text-xl font-bold leading-tight">{use.data.title}</h3>
  <p class="mt-1 line-clamp-2 text-sm text-slate-400">
    {use.data.description}
  </p>
</a>
