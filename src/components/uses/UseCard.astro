---
import type { CollectionEntry } from 'astro:content'
import EntityCard from '../EntityCard.astro'
import UseMeta from './UseMeta.astro'

interface Props {
  use: CollectionEntry<'uses'>
}

const { use } = Astro.props
---

<EntityCard
  href={`/uses/${use.id}`}
  title={use.data.title}
  description={use.data.description}
  image={use.data.image}
  areas={use.data.areas}
  transitionPrefix={`use-${use.data.title}`}
  preloadWidth="1640"
  preloadHeight="1094"
>
  <UseMeta slot="meta" use={use} align="left" />
</EntityCard>
