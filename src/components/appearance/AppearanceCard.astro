---
import type { CollectionEntry } from 'astro:content'
import EntityCard from '../EntityCard.astro'
import AppearanceMeta from './AppearanceMeta.astro'

interface Props {
  appearance: CollectionEntry<'appearances'>
  eager?: boolean
}
const { appearance, eager } = Astro.props
---

<EntityCard
  eager={eager}
  href={`/appearances/${appearance.id}`}
  title={appearance.data.title}
  description={appearance.data.description}
  image={appearance.data.heroImage}
  areas={appearance.data.areas}
  transitionPrefix={`appearance-${appearance.id}`}
>
  <AppearanceMeta slot="meta" appearance={appearance} align="left" />
</EntityCard>
