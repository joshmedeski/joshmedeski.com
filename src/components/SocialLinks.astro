---
import { SOCIAL_LINKS } from '../config'
import Link from './Link.astro'
import {
  DiscordIcon,
  GitHubIcon,
  RssIcon,
  TikTokIcon,
  TwitterIcon,
  YouTubeIcon,
} from './icons/index.astro'

interface Props {
  iconSize?: string
}

const { iconSize = 'h-10' } = Astro.props
const links = [
  [SOCIAL_LINKS.YouTube, YouTubeIcon],
  [SOCIAL_LINKS.GitHub, GitHubIcon],
  [SOCIAL_LINKS.Discord, DiscordIcon],
  [SOCIAL_LINKS.X, TwitterIcon],
  [SOCIAL_LINKS.TikTok, TikTokIcon],
  ['/rss.xml', RssIcon],
] as const
---

<div class="flex gap-4">
  {
    links.map(([href, Icon]) => (
      <Link href={href} target="_blank">
        <Icon class={iconSize} />
      </Link>
    ))
  }
</div>
