---
import type { CollectionEntry } from 'astro:content'

interface Props {
  areas: CollectionEntry<'areas'>[]
  composition: 'mesh' | 'sweep' | 'diagonal'
}

const { areas, composition } = Astro.props
const style = areas
  .map((a) => a.data.themeColor?.replace(/^bg-/, '--theme-color-'))
  .filter(Boolean)
  .slice(0, 3)
  .map((v, i) => `--area-${i + 1}: var(${v})`)
  .join(';')
---

<div
  class="area-hero relative"
  style={style}
  data-composition={composition}
  data-texture={areas[0]?.data.texture ?? 'film'}
>
  <div class="area-hero-bg" aria-hidden="true"></div>
  <div class="relative"><slot /></div>
</div>
