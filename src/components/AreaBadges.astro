---
import { getEntry } from 'astro:content'
import { areaHref } from '~/utils/areas'
import AreaIcon from './AreaIcon.astro'

interface Props {
  areas?: { collection: 'areas'; id: string }[]
  pillClass?: string
}
const {
  areas = [],
  pillClass = 'flex items-center gap-1 rounded-full bg-neutral-800 px-3 py-1 text-sm text-neutral-200',
} = Astro.props
const resolved = (
  await Promise.all((areas ?? []).map((ref) => getEntry(ref)))
).filter((a) => a != null)
---

{
  resolved.length > 0 && (
    <ul class="contents">
      {resolved.map((area) => (
        <li>
          <a href={areaHref(area)} class={`${pillClass} hover:bg-neutral-700`}>
            <AreaIcon icon={area.data.icon} />
            <span>{area.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
