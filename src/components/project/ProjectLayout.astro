---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from '../Layout.astro'
import Wrapper from '../Wrapper.astro'
import ProjectMeta from './ProjectMeta.astro'
import ProjectCta from './ProjectCta.astro'
import PostCard from '../post/PostCard.astro'
import AppearanceCard from '../appearance/AppearanceCard.astro'
import { resolveThemeArea } from '~/utils/areas'
import { entriesForProject, splitVideos } from '~/utils/projects'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const areas = await getCollection('areas')
const themeColor =
  resolveThemeArea(project, areas)?.data.themeColor ?? 'bg-neutral-900'

const includeDrafts = import.meta.env.DEV
const allPosts = await getCollection(
  'posts',
  ({ data }) => includeDrafts || !data.draft,
)
const { videos, articles } = splitVideos(entriesForProject(project, allPosts))
const appearances = entriesForProject(
  project,
  await getCollection('appearances'),
)
---

<Layout
  title={project.data.title}
  description={project.data.description}
  image={project.data.heroImage}
  themeColor={themeColor}
>
  <div data-pagefind-body>
    <div class={themeColor}>
      <section class="pb-64 pt-16">
        <Wrapper>
          <header class="flex flex-col gap-6">
            <div
              class="relative mx-auto mb-12 aspect-video w-full max-w-[810px]"
            >
              <Image
                class="absolute inset-0 z-10 aspect-video w-full rounded-xl bg-black shadow-lg"
                src={project.data.heroImage}
                width="1920"
                height="1080"
                alt={`${project.data.title} hero`}
                transition:name={`project-${project.id}-thumb`}
              />
            </div>

            <div class="text-center">
              <h1
                class="mb-4 text-balance text-4xl font-extrabold md:text-6xl"
                transition:name={`project-${project.id}-title`}
              >
                {project.data.title}
              </h1>
              <ProjectMeta project={project} size="lg" />
              {
                project.data.cta && (
                  <ProjectCta cta={project.data.cta} class="mt-6" />
                )
              }
            </div>
          </header>
        </Wrapper>
      </section>
    </div>

    <div
      class="-mt-48 mx-auto max-w-[760px] rounded-t-[2.5rem] bg-black px-6 pt-8 md:px-10 md:pt-10"
    >
      <main class="prose prose-invert prose-lg max-w-full pb-16 md:pb-20">
        <slot />
        {
          project.data.cta && (
            <div class="mt-12 text-center" data-pagefind-ignore>
              <ProjectCta cta={project.data.cta} />
            </div>
          )
        }
      </main>
    </div>

    {
      (videos.length > 0 || articles.length > 0 || appearances.length > 0) && (
        <Wrapper>
          <div data-pagefind-ignore>
            {videos.length > 0 && (
              <section class="py-12">
                <h2 class="mb-6 text-2xl font-bold">Videos</h2>
                <div class="grid gap-4 sm:grid-cols-2 sm:gap-8">
                  {videos.map((video) => (
                    <PostCard post={video} />
                  ))}
                </div>
              </section>
            )}
            {articles.length > 0 && (
              <section class="py-12">
                <h2 class="mb-6 text-2xl font-bold">Posts</h2>
                <div class="grid gap-4 sm:grid-cols-2 sm:gap-8">
                  {articles.map((post) => (
                    <PostCard post={post} />
                  ))}
                </div>
              </section>
            )}
            {appearances.length > 0 && (
              <section class="py-12">
                <h2 class="mb-6 text-2xl font-bold">Appearances</h2>
                <div class="grid gap-4 sm:grid-cols-2 sm:gap-8">
                  {appearances.map((appearance) => (
                    <AppearanceCard appearance={appearance} />
                  ))}
                </div>
              </section>
            )}
          </div>
        </Wrapper>
      )
    }
  </div>
</Layout>
