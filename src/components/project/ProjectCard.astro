---
import type { CollectionEntry } from 'astro:content'
import EntityCard from '../EntityCard.astro'
import ProjectMeta from './ProjectMeta.astro'

interface Props {
  project: CollectionEntry<'projects'>
  eager?: boolean
}
const { project, eager } = Astro.props
---

<EntityCard
  eager={eager}
  href={`/projects/${project.id}`}
  title={project.data.title}
  description={project.data.description}
  image={project.data.heroImage}
  areas={project.data.areas}
  transitionPrefix={`project-${project.id}`}
>
  <ProjectMeta slot="meta" project={project} align="left" />
</EntityCard>
