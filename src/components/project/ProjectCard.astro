---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import ProjectMeta from './ProjectMeta.astro'
import { resolveThemeArea } from '~/utils/areas'

interface Props {
  project: CollectionEntry<'projects'>
}
const { project } = Astro.props
const areas = await getCollection('areas')
const themeColor =
  resolveThemeArea(project, areas)?.data.themeColor ?? 'bg-neutral-900'
// Tailwind can't generate a `border-*` class built at runtime, so the border
// color comes from the theme variable backing the area's `bg-*` utility.
const borderColor = `var(${themeColor.replace('bg-', '--color-')})`
---

<div
  class=`relative flex flex-col justify-end rounded-lg border-2 px-4 py-4 shadow-md md:px-6 ${themeColor}`
  style={`border-color: ${borderColor}`}
>
  <a
    href={`/projects/${project.id}`}
    class="z-20 grid grow gap-4 md:grid-cols-5 md:gap-6"
    data-astro-prefetch
  >
    <div
      class="flex flex-col justify-end md:col-span-2 md:col-start-4 md:row-start-1"
    >
      <Image
        src={project.data.heroImage}
        alt={project.data.title}
        width="500"
        height="281.25"
        class="mb-2 aspect-video w-full rounded-lg bg-black shadow-md md:mb-8"
        transition:name={`project-${project.id}-thumb`}
        style={{ backgroundColor: '#000' }}
      />
    </div>

    <div
      class="md:col-start-0 flex flex-col justify-end md:col-span-3 md:row-start-1"
    >
      <div class="flex grow flex-col justify-center">
        <h3
          class="mb-2 mr-4 text-balance text-xl font-extrabold leading-tight"
          transition:name={`project-${project.id}-title`}
        >
          {project.data.title}
        </h3>
      </div>

      <p
        class="-ml-3 mb-12 rounded-t-md bg-neutral-900 p-3 text-sm text-slate-500"
      >
        {project.data.description}
      </p>
    </div>
  </a>

  <div
    class="z-10 -mx-4 -mb-4 -mt-20 rounded-b-md bg-neutral-900 px-4 pb-2 pt-14 md:-mx-6 md:px-6"
  >
    <ProjectMeta project={project} align="left" />
  </div>
</div>
