{
  "name": "joshmedeski.com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "prettier --check .",
    "dev": "netlify dev",
    "dev-msw": "NODE_ENV=development NODE_OPTIONS=\"--require ./mocks/index.cjs\" netlify dev",
    "format": "prettier --write .",
    "preview": "astro preview",
    "refresh:stats": "node --env-file=.env scripts/refresh-stats.ts",
    "refresh:videos": "node --env-file=.env scripts/refresh-videos.ts",
    "pagefind:playground": "pnpm run build && pnpx pagefind --site dist --serve",
    "start": "astro dev --host",
    "sync": "astro sync",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/preact": "^6.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@netlify/functions": "^6.0.3",
    "@pagefind/component-ui": "^1.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "astro-expressive-code": "^0.44.3",
    "astro-pagefind": "^2.0.1",
    "clsx": "^2.1.1",
    "pagefind": "^1.6.0",
    "preact": "^10.29.8",
    "satteri": "^0.10.5",
    "satteri-callouts": "^1.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "lefthook": "^2.2.2",
    "msw": "^2.15.0",
    "netlify-plugin-cache": "^1.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
