{
  "name": "joshmedeski.com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "prettier --check .",
    "dev": "netlify dev",
    "dev-msw": "cross-env NODE_ENV=development binode --require ./mocks/index.cjs -- netlify-cli:netlify dev",
    "format": "prettier --write .",
    "preview": "astro preview",
    "refresh:stats": "node --env-file=.env scripts/refresh-stats.ts",
    "refresh:videos": "node --env-file=.env scripts/refresh-videos.ts",
    "pagefind:playground": "pnpm run build && pnpx pagefind --site dist --serve",
    "start": "astro dev --host",
    "sync": "astro sync",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/preact": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/functions": "^6.0.0",
    "@pagefind/component-ui": "^1.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "astro-expressive-code": "^0.44.1",
    "astro-pagefind": "^2.0.1",
    "clsx": "^2.1.1",
    "pagefind": "^1.5.2",
    "preact": "^10.29.8",
    "satteri": "^0.10.5",
    "satteri-callouts": "^1.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "binode": "^1.0.5",
    "cross-env": "^7.0.3",
    "lefthook": "^2.1.12",
    "msw": "^2.15.0",
    "netlify-cli": "^27.4.1",
    "netlify-plugin-cache": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.103.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
